{
  "name": "konoha-village",
  "version": "0.1.0",
  "private": true,
  "description": "Konoha Village — a Naruto-themed operator board for a Claude agent company (Agent Works + clauboard, re-skinned as the Hidden Leaf).",
  "scripts": {
    "dev": "next dev",
    "dev:live": "NEXT_PUBLIC_ORCH_WS=ws://localhost:8787 next dev",
    "server": "tsx server/mock-orchestrator.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
