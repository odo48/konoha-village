# Mock orchestrator (REST + WebSocket), run via tsx.
# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY server ./server
COPY src ./src
ENV ORCH_PORT=8787
EXPOSE 8787
CMD ["npx", "tsx", "server/mock-orchestrator.ts"]
